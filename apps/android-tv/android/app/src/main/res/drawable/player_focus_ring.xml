<?xml version="1.0" encoding="utf-8"?>
<!-- Focus ring of the Media3 controls: a dark outer ring and a light inner
     one, so it reads on bright and dark pictures alike. Drawn as the button's
     foreground, over Media3's own background, and inset so the grown button
     at the screen edge keeps the whole ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <stroke android:width="3dp" android:color="#E6000000" />
                </shape>
            </item>
            <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
                <shape android:shape="rectangle">
                    <corners android:radius="100dp" />
                    <stroke android:width="3dp" android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
