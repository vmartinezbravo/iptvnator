<?xml version="1.0" encoding="utf-8"?>
<!-- Time bar thumb. Focused, it grows into the controls' focus ring (dark
     outside, light inside) around a white disc. Both states are 30 dp, so the
     time bar reserves room for the grown thumb from the start. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="30dp" android:height="30dp" />
                    <solid android:color="#E6000000" />
                </shape>
            </item>
            <item android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
            <item android:top="6dp" android:bottom="6dp" android:left="6dp" android:right="6dp">
                <shape android:shape="oval">
                    <solid android:color="#E6000000" />
                </shape>
            </item>
            <item android:top="8dp" android:bottom="8dp" android:left="8dp" android:right="8dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="30dp" android:height="30dp" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
            <item android:top="9dp" android:bottom="9dp" android:left="9dp" android:right="9dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
