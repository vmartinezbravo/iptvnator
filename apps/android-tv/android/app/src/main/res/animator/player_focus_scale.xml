<?xml version="1.0" encoding="utf-8"?>
<!-- The focused Media3 control grows a little. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="1.15" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="1.15" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="120" android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" />
            <objectAnimator android:duration="120" android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" />
        </set>
    </item>
</selector>
